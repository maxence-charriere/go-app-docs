{"short_name":"Documentation for go-app","name":"Documentation for go-app","description":"A package for building progressive web apps (PWA) with the Go programming language (Golang) and WebAssembly (Wasm). It uses a declarative syntax that allows creating and dealing with HTML elements only by using Go, and without writing any HTML markup.","scope":"/","start_url":"/","background_color":"#2e343a","theme_color":"#2e343a","display":"standalone","icons":[{"src":"https://raw.githubusercontent.com/maxence-charriere/go-app/master/docs/web/icon.png","type":"image/png","purpose":"maskable","sizes":"512x512"},{"src":"https://raw.githubusercontent.com/maxence-charriere/go-app/master/docs/web/icon.svg","type":"image/svg+xml","purpose":"","sizes":"any"},{"src":"https://raw.githubusercontent.com/maxence-charriere/go-app/master/docs/web/icon.png","type":"image/png","purpose":"","sizes":"512x512"},{"src":"https://raw.githubusercontent.com/maxence-charriere/go-app/master/docs/web/icon.png","type":"image/png","purpose":"","sizes":"192x192"}]}